{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "src",
    "vite.config.ts",
    "capacitor.config.ts",
    "../src/features/catalog",
    "../src/features/bookings",
    "../src/modules/catalog",
    "../src/modules/bookings"
  ],
  "exclude": [
    "../src/features/catalog/web-*.tsx",
    "../src/features/bookings/require-booking-staff.ts"
  ]
}
