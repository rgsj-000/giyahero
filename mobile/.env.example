# Public values only: never a service-role key.
VITE_SUPABASE_URL=https://YOUR-STAGING-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-STAGING-PUBLISHABLE-OR-ANON-KEY
VITE_WEB_ORIGIN=https://YOUR-STAGING-DOMAIN
VITE_AUTH_CALLBACK_URL=https://YOUR-STAGING-DOMAIN/mobile/auth/callback
# Explicitly enable only for local browser previews. Native always uses secure storage.
VITE_BROWSER_PREVIEW=false
# Reserve your actual identifiers before generating release projects.
GIYAHERO_APP_ID=YOUR.REVERSE.DOMAIN.staging
GIYAHERO_APP_NAME=GiyaHero Staging
# Required for release validation and HTTPS link associations.
GIYAHERO_ENVIRONMENT=staging
GIYAHERO_APPLE_TEAM_ID=YOUR_TEAM_ID
GIYAHERO_ANDROID_SHA256=YOUR_SIGNING_CERTIFICATE_SHA256
